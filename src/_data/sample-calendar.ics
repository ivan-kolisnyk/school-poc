BEGIN:VCALENDAR
PRODID:-//Courtenay POC//Sample calendar//EN
VERSION:2.0
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Courtenay sample events (POC)
X-WR-TIMEZONE:America/Chicago
X-WR-CALDESC:Invented sample events used until site.calendarIcs points at the school's Google Calendar feed.
BEGIN:VTIMEZONE
TZID:America/Chicago
X-LIC-LOCATION:America/Chicago
BEGIN:DAYLIGHT
TZOFFSETFROM:-0600
TZOFFSETTO:-0500
TZNAME:CDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0500
TZOFFSETTO:-0600
TZNAME:CST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:sample-library-early@courtenay-poc
DTSTAMP:20260901T120000Z
DTSTART;TZID=America/Chicago:20260901T074500
DTEND;TZID=America/Chicago:20260901T081500
RRULE:FREQ=WEEKLY;BYDAY=TU
SUMMARY:Library open early
LOCATION:Library
DESCRIPTION:Students can read, return books and check out new ones before school.
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:sample-coffee-principal@courtenay-poc
DTSTAMP:20260901T120000Z
DTSTART;TZID=America/Chicago:20260904T083000
DTEND;TZID=America/Chicago:20260904T093000
RRULE:FREQ=MONTHLY;BYDAY=1FR
SUMMARY:Coffee with the principal
LOCATION:Room 108
DESCRIPTION:Drop in after drop-off for coffee and questions. All families are welcome.
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:sample-pac-meeting@courtenay-poc
DTSTAMP:20260901T120000Z
DTSTART;TZID=America/Chicago:20260910T180000
DTEND;TZID=America/Chicago:20260910T190000
RRULE:FREQ=MONTHLY;BYDAY=2TH
SUMMARY:PAC meeting
LOCATION:Library
DESCRIPTION:Parent Advisory Council monthly meeting. Everyone is welcome.
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:sample-family-reading@courtenay-poc
DTSTAMP:20260901T120000Z
DTSTART;TZID=America/Chicago:20260930T173000
DTEND;TZID=America/Chicago:20260930T183000
RRULE:FREQ=MONTHLY;BYDAY=-1WE
SUMMARY:Family reading night
LOCATION:Library
DESCRIPTION:Read together with your child. Books and snacks provided.
