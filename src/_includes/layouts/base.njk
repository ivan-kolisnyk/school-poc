<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.name }}</title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <header class="site-header">
    <div class="container bar">
      <a class="brand" href="/">{{ site.name }}</a>
      <nav>
        <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
        <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">{{ content | safe }}</main>

  <footer class="site-footer">
    <div class="container">
      <strong>{{ site.name }}</strong><br>
      {{ site.address }}<br>
      {{ site.phone }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
      {{ site.hours }}
    </div>
  </footer>
</body>
</html>
