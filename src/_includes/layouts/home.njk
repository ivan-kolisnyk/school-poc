---
layout: layouts/base.njk
---
<section class="hero">
  <div class="container">
    <h1 class="{{ hero_heading | headingClass }}">{{ hero_heading }}</h1>
    <p>{{ hero_sub }}</p>
  </div>
</section>

<div class="container grid">
  <article class="prose">{{ content | safe }}</article>

  <aside class="card">
    {#- Interim until Task 8 rebuilds the homepage: the next 4 events (DESIGN.md 10.9). #}
    <h2>{{ strings.events.heading }}</h2>
    {%- set items = events.items %}
    {%- set limit = 4 %}
    {%- set eventLevel = 3 %}
    {%- set showDescription = false %}
    {% include "partials/events-list.njk" %}
    <p class="events-more"><a href="/events/">{{ strings.events.seeFullCalendar }}</a></p>
  </aside>
</div>

<section class="container">
  <h2>Latest news</h2>
  {#- Interim until Task 8 rebuilds the homepage: the 3 newest posts as cards. #}
  <div class="news-grid">
    {%- for post in collections.newsDesc.slice(0, 3) %}
    {% include "partials/news-card.njk" %}
    {%- endfor %}
  </div>
</section>
