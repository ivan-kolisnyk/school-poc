---
layout: layouts/base.njk
---
<section class="hero">
  <div class="container">
    <h1 class="{{ hero_heading | headingClass }}">{{ hero_heading }}</h1>
    <p>{{ hero_sub }}</p>
  </div>
</section>

<div class="container grid">
  <article class="prose">{{ content | safe }}</article>

  <aside class="card">
    <h2>Upcoming dates</h2>
    <ul class="dates">
      {% for item in calendar.items %}
      <li><time>{{ item.date | dateDisplay }}</time> {{ item.label }}</li>
      {% endfor %}
    </ul>
  </aside>
</div>

<section class="container">
  <h2>Latest news</h2>
  {#- Interim until Task 8 rebuilds the homepage: the 3 newest posts as cards. #}
  <div class="news-grid">
    {%- for post in collections.newsDesc.slice(0, 3) %}
    {% include "partials/news-card.njk" %}
    {%- endfor %}
  </div>
</section>
