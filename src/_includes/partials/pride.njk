{#- Pride band (DESIGN.md 10.7, 8): the page's one gold band and its one use of the stripe
    motif. Stripes frame a solid gold panel, so they never sit behind the facts' text.
    Facts are static (no count-up) and come from the homepage front matter `pride`. -#}
{%- if pride and pride.length %}
<section class="pride" data-home-section="pride" aria-labelledby="pride-title">
  <div class="container">
    <div class="pride__panel">
      <h2 class="visually-hidden" id="pride-title">{{ strings.home.prideHeading }}</h2>
      <ul class="pride__list" role="list">
        {%- for fact in pride %}
        <li class="pride__item">
          <span class="pride__value">{{ fact.value }}</span>
          <span class="pride__label">{{ fact.label }}</span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
{%- endif %}
