---
layout: layouts/base.njk
permalink: /events/
eleventyComputed:
  title: "{{ strings.events.heading }}"
---
{#- All upcoming events from the school's Google Calendar, grouped by month (DESIGN.md 10.9). -#}
{%- set headerTitle = strings.events.heading -%}
{%- set headerSentence = false -%}
{%- set headerCrumbs = [] -%}
{%- set headerDate = false -%}
{% include "partials/page-header.njk" %}

<div class="section">
  <div class="container events" data-events-source="{{ events.source }}">
    {%- set eventLevel = 3 %}
    {%- set limit = false %}
    {%- set showDescription = true %}
    {%- if events.items.length %}
    {%- for group in events.items | eventMonths %}
    <section class="events-month" aria-labelledby="events-{{ group.key }}">
      <h2 class="events-month__title" id="events-{{ group.key }}">{{ group.label }}</h2>
      {%- set items = group.items %}
      {% include "partials/events-list.njk" %}
    </section>
    {%- endfor %}
    {%- set _ext %}{% icon "external-link", strings.a11y.externalCps %}{% endset %}
    <p class="events-note">{{ strings.events.cpsCalendarNote | linkPhrase(strings.events.cpsCalendar, site.links.cpsCalendar, _ext) | safe }}</p>
    {%- else %}
    {%- set items = [] %}
    {% include "partials/events-list.njk" %}
    {%- endif %}
  </div>
</div>
